# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# AI Service Configuration
# Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Branding Settings
BRAND_HANDLE=@intstg_stories
BRAND_NAME=StoriesHub

# Output Settings
OUTPUT_DIR=output

# Optional Proxy Configuration (required for Gemini/Images in Russia/Iran/restricted regions)
# HTTP_PROXY=http://127.0.0.1:10809

# Custom Telegram API server URL to bypass ISP blocks in Russia
# Defaults to https://api.telegram-proxy.org
TELEGRAM_API_URL=https://api.telegram-proxy.org

